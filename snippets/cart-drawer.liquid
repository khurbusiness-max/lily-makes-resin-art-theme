<div class="cart-drawer-shell" data-cart-shell hidden>
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside id="CartDrawer" class="cart-drawer" aria-label="Your cart" aria-modal="true" role="dialog" tabindex="-1" data-cart-drawer>
    <div class="cart-drawer__header">
      <h2>Your cart</h2>
      <button class="icon-button" type="button" aria-label="Close cart" data-cart-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="cart-drawer__items" data-cart-items>
      {%- if cart.item_count == 0 -%}
        <p class="cart-drawer__empty">Your cart is empty.</p>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="cart-item" data-line-key="{{ item.key }}">
            <img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="90" height="90">
            <div class="cart-item__details">
              <h3>{{ item.product.title }}</h3>
              <p>{{ item.variant.title }}</p>
              <div class="cart-item__controls">
                <button type="button" data-cart-decrement aria-label="Decrease quantity">-</button>
                <span>{{ item.quantity }}</span>
                <button type="button" data-cart-increment aria-label="Increase quantity">+</button>
                <button class="cart-item__remove" type="button" data-cart-remove aria-label="Remove item">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18m-2 0-.7 14H5.7L5 6m4 0V4h6v2"/></svg>
                </button>
              </div>
            </div>
            <div class="cart-item__price">
              {%- if item.variant.compare_at_price > item.final_price -%}
                <s>{{ item.variant.compare_at_price | money }}</s>
              {%- endif -%}
              <strong>{{ item.final_line_price | money }}</strong>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="cart-drawer__footer">
      <div class="cart-subtotal">
        <span>Subtotal</span>
        <strong data-cart-subtotal>{{ cart.total_price | money_with_currency }}</strong>
      </div>
      <button class="button button--primary" type="button" data-checkout>Check out</button>
    </div>
  </aside>
</div>
