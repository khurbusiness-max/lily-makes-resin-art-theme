{%- liquid
  assign card_title = section.settings.fallback_title
  assign card_price = section.settings.fallback_price
  assign card_compare = section.settings.fallback_compare
  assign card_url = routes.root_url
  assign card_image = blank
  assign catalog_image = section.settings.catalog_image

  if product != blank
    assign card_title = product.title
    assign card_price = product.price | money
    if product.compare_at_price > product.price
      assign card_compare = product.compare_at_price | money
    endif
    assign card_url = product.url
    assign card_image = product.featured_image
  endif

  if catalog_image != blank
    assign card_image = catalog_image
  endif
-%}

<article class="product-card">
  <a class="product-card__image" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
    {%- if card_image != blank -%}
      <img src="{{ card_image | image_url: width: 700 }}" alt="{{ card_image.alt | default: card_title | escape }}" width="700" height="700" loading="lazy">
    {%- else -%}
      <img src="{{ 'lmra-product-main.svg' | asset_url }}" alt="{{ card_title | escape }}" width="700" height="700" loading="lazy">
    {%- endif -%}
    <span>{{ section.settings.discount_badge }}</span>
  </a>

  <div class="product-card__body">
    <h2><a href="{{ card_url }}">{{ card_title }}</a></h2>
    <p><strong>From {{ card_price }}</strong> <s>{{ card_compare }}</s></p>
    <a class="button button--primary" href="{{ card_url }}">{{ section.settings.button_text }}</a>
  </div>
</article>