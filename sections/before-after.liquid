<section class="before-after page-width">
  <div class="before-after__copy">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="before-after__media" aria-label="{{ section.settings.heading | escape }}">
    <div class="before-after__panel">
      <span>{{ section.settings.before_label }}</span>
      {%- if section.settings.before_image != blank -%}
        <img src="{{ section.settings.before_image | image_url: width: 700 }}" alt="{{ section.settings.before_alt | escape }}" width="700" height="700" loading="lazy">
      {%- else -%}
        <img src="{{ 'lmra-before.svg' | asset_url }}" alt="{{ section.settings.before_alt | escape }}" width="700" height="700" loading="lazy">
      {%- endif -%}
    </div>
    <div class="before-after__divider" aria-hidden="true"></div>
    <div class="before-after__panel">
      <span>{{ section.settings.after_label }}</span>
      {%- if section.settings.after_image != blank -%}
        <img src="{{ section.settings.after_image | image_url: width: 700 }}" alt="{{ section.settings.after_alt | escape }}" width="700" height="700" loading="lazy">
      {%- else -%}
        <img src="{{ 'lmra-after.svg' | asset_url }}" alt="{{ section.settings.after_alt | escape }}" width="700" height="700" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before and after",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Desk Decor to Movie Scene"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Slide to see the difference. By day, it is a detailed handmade resin display. At night, the blue glow turns it into a dramatic monster scene for your room."
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "before_alt",
      "label": "Before alt text",
      "default": "Resin lamp in daylight"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "after_alt",
      "label": "After alt text",
      "default": "Resin lamp glowing at night"
    }
  ],
  "presets": [
    {
      "name": "Before and after"
    }
  ]
}
{% endschema %}
