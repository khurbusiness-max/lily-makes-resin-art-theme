Paste this as your full new `sections/before-after.liquid` code:

```liquid
<section class="before-after page-width">
  <div class="before-after__copy">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>

  <div
    class="before-after__media"
    data-before-after-slider
    style="--position: 50%;"
    aria-label="{{ section.settings.heading | escape }}"
  >
    <div class="before-after__image before-after__image--after">
      <span>{{ section.settings.after_label }}</span>
      {%- if section.settings.after_image != blank -%}
        <img src="{{ section.settings.after_image | image_url: width: 900 }}" alt="{{ section.settings.after_alt | escape }}" width="900" height="900" loading="lazy">
      {%- else -%}
        <img src="{{ 'lmra-after.svg' | asset_url }}" alt="{{ section.settings.after_alt | escape }}" width="900" height="900" loading="lazy">
      {%- endif -%}
    </div>

    <div class="before-after__image before-after__image--before">
      <span>{{ section.settings.before_label }}</span>
      {%- if section.settings.before_image != blank -%}
        <img src="{{ section.settings.before_image | image_url: width: 900 }}" alt="{{ section.settings.before_alt | escape }}" width="900" height="900" loading="lazy">
      {%- else -%}
        <img src="{{ 'lmra-before.svg' | asset_url }}" alt="{{ section.settings.before_alt | escape }}" width="900" height="900" loading="lazy">
      {%- endif -%}
    </div>

    <div class="before-after__divider" aria-hidden="true">
      <span></span>
    </div>

    <label class="visually-hidden" for="BeforeAfterSlider-{{ section.id }}">
      Move right to show more morning mode. Move left to show more night mode.
    </label>
    <input
      id="BeforeAfterSlider-{{ section.id }}"
      class="before-after__range"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      data-before-after-range
      aria-label="Compare morning and night mode"
    >
  </div>
</section>

<style>
  .before-after {
    display: grid;
    grid-template-columns: 1fr 0.86fr;
    gap: 70px;
    align-items: center;
    padding: 40px 0 72px;
  }

  .before-after__copy {
    text-align: center;
  }

  .before-after h2 {
    margin: 0 0 24px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    font-weight: 950;
  }

  .before-after p {
    max-width: 66ch;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  .before-after__media {
    --position: 50%;
    position: relative;
    overflow: hidden;
    background: #050609;
    user-select: none;
  }

  .before-after__image {
    position: relative;
    width: 100%;
  }

  .before-after__image img {
    width: 100%;
    aspect-ratio: 1 / 1.12;
    object-fit: cover;
    display: block;
  }

  .before-after__image span {
    position: absolute;
    top: 0;
    z-index: 4;
    background: #273985;
    color: #fff;
    padding: 5px 14px;
    font-size: 0.82rem;
    font-weight: 950;
  }

  .before-after__image--after span {
    right: 0;
  }

  .before-after__image--before {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: var(--position);
    overflow: hidden;
  }

  .before-after__image--before img {
    width: auto;
    max-width: none;
    height: 100%;
    min-width: 100%;
  }

  .before-after__image--before span {
    left: 0;
  }

  .before-after__divider {
    position: absolute;
    inset-block: 0;
    left: var(--position);
    z-index: 5;
    width: 4px;
    transform: translateX(-50%);
    background: #fff;
    pointer-events: none;
  }

  .before-after__divider span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 34px;
    height: 34px;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  .before-after__divider span::before,
  .before-after__divider span::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 8px;
    height: 8px;
    border-top: 2px solid #273985;
    border-left: 2px solid #273985;
  }

  .before-after__divider span::before {
    left: 9px;
    transform: translateY(-50%) rotate(-45deg);
  }

  .before-after__divider span::after {
    right: 9px;
    transform: translateY(-50%) rotate(135deg);
  }

  .before-after__range {
    position: absolute;
    inset: 0;
    z-index: 6;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .before-after__media:focus-within .before-after__divider span {
    outline: 3px solid rgba(56, 189, 248, 0.45);
    outline-offset: 3px;
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 980px) {
    .before-after {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-before-after-slider]').forEach(function (slider) {
      var range = slider.querySelector('[data-before-after-range]');
      if (!range) return;

      function updatePosition() {
        slider.style.setProperty('--position', range.value + '%');
      }

      range.addEventListener('input', updatePosition);
      range.addEventListener('change', updatePosition);
      updatePosition();
    });
  });
</script>

