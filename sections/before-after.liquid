<section class="ba-section page-width" id="BeforeAfter-{{ section.id }}">
  <div class="ba-copy">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>

  <div class="ba-slider" style="--ba-position: 50%;">
    <div class="ba-image ba-image--after">
      <span class="ba-label ba-label--after">{{ section.settings.after_label }}</span>
      {% if section.settings.after_image != blank %}
        {{ section.settings.after_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.after_alt }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ba-placeholder' }}
      {% endif %}
    </div>

    <div class="ba-image ba-image--before">
      <span class="ba-label ba-label--before">{{ section.settings.before_label }}</span>
      {% if section.settings.before_image != blank %}
        {{ section.settings.before_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.before_alt }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ba-placeholder' }}
      {% endif %}
    </div>

    <div class="ba-handle" aria-hidden="true">
      <span></span>
    </div>

    <input class="ba-range" type="range" min="0" max="100" value="50" step="1" aria-label="Move slider to compare morning and night mode">
  </div>
</section>

<style>
  #BeforeAfter-{{ section.id }}.ba-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 450px);
    align-items: center;
    gap: 70px;
    padding: 48px 0 80px;
  }

  #BeforeAfter-{{ section.id }} .ba-copy {
    text-align: center;
  }

  #BeforeAfter-{{ section.id }} .ba-copy h2 {
    margin: 0 0 24px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    font-weight: 950;
  }

  #BeforeAfter-{{ section.id }} .ba-copy p {
    max-width: 62ch;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.55;
  }

  #BeforeAfter-{{ section.id }} .ba-slider {
    --ba-position: 50%;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.12;
    overflow: hidden;
    background: #050609;
  }

  #BeforeAfter-{{ section.id }} .ba-image {
    position: absolute;
    inset: 0;
  }

  #BeforeAfter-{{ section.id }} .ba-image img,
  #BeforeAfter-{{ section.id }} .ba-image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #BeforeAfter-{{ section.id }} .ba-image--after {
    z-index: 1;
  }

  #BeforeAfter-{{ section.id }} .ba-image--before {
    z-index: 2;
    clip-path: inset(0 calc(100% - var(--ba-position)) 0 0);
  }

  #BeforeAfter-{{ section.id }} .ba-label {
    position: absolute;
    top: 0;
    z-index: 4;
    background: #273985;
    color: #fff;
    padding: 5px 14px;
    font-size: 0.82rem;
    font-weight: 950;
  }

  #BeforeAfter-{{ section.id }} .ba-label--before {
    left: 0;
  }

  #BeforeAfter-{{ section.id }} .ba-label--after {
    right: 0;
  }

  #BeforeAfter-{{ section.id }} .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--ba-position);
    z-index: 5;
    width: 4px;
    transform: translateX(-50%);
    background: #fff;
    pointer-events: none;
  }

  #BeforeAfter-{{ section.id }} .ba-handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 36px;
    height: 36px;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  #BeforeAfter-{{ section.id }} .ba-range {
    position: absolute;
    inset: 0;
    z-index: 10;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  @media (max-width: 980px) {
    #BeforeAfter-{{ section.id }}.ba-section {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
</style>

<script>
  document.addEventListener('input', function(event) {
    if (!event.target.classList.contains('ba-range')) return;
    var slider = event.target.closest('.ba-slider');
    if (!slider) return;
    slider.style.setProperty('--ba-position', event.target.value + '%');
  });
</script>

{% schema %}
{
  "name": "Before and after",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Desk Decor to Movie Scene"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Slide to see the difference. By day, it is a detailed handmade resin display. At night, the blue glow turns it into a dramatic monster resin scene for your room."
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "before_alt",
      "label": "Before alt text",
      "default": "Resin lamp in daylight"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "after_alt",
      "label": "After alt text",
      "default": "Resin lamp glowing at night"
    }
  ],
  "presets": [
    {
      "name": "Before and after"
    }
  ]
}
{% endschema %}