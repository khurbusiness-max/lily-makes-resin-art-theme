<section class="before-after page-width">
  <div class="before-after__copy">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="before-after__media" aria-label="{{ section.settings.heading | escape }}" id="ba-slider-{{ section.id }}">
    <div class="before-after__panel ba-before">
      <span class="ba-label">{{ section.settings.before_label }}</span>
      {%- if section.settings.before_image != blank -%}
        <img src="{{ section.settings.before_image | image_url: width: 700 }}" alt="{{ section.settings.before_alt | escape }}" width="700" height="700" loading="lazy">
      {%- else -%}
        <img src="{{ 'lmra-before.svg' | asset_url }}" alt="{{ section.settings.before_alt | escape }}" width="700" height="700" loading="lazy">
      {%- endif -%}
    </div>
    <div class="before-after__panel ba-after">
      <span class="ba-label ba-label--after">{{ section.settings.after_label }}</span>
      {%- if section.settings.after_image != blank -%}
        <img src="{{ section.settings.after_image | image_url: width: 700 }}" alt="{{ section.settings.after_alt | escape }}" width="700" height="700" loading="lazy">
      {%- else -%}
        <img src="{{ 'lmra-after.svg' | asset_url }}" alt="{{ section.settings.after_alt | escape }}" width="700" height="700" loading="lazy">
      {%- endif -%}
    </div>
    <div class="ba-divider" aria-hidden="true">
      <div class="ba-handle">&#9664;&#9654;</div>
    </div>
  </div>
</section>

<style>
  #ba-slider-{{ section.id }} {
    position: relative;
    overflow: hidden;
    cursor: col-resize;
    user-select: none;
  }
  #ba-slider-{{ section.id }} .before-after__panel {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
  }
  #ba-slider-{{ section.id }} .ba-before {
    z-index: 1;
    width: 50%;
    overflow: hidden;
  }
  #ba-slider-{{ section.id }} .ba-before img,
  #ba-slider-{{ section.id }} .ba-after img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  #ba-slider-{{ section.id }} .ba-after {
    z-index: 0;
  }
  #ba-slider-{{ section.id }} .ba-after img {
    position: absolute;
    top: 0; left: 0;
  }
  #ba-slider-{{ section.id }} .ba-label {
    position: absolute;
    top: 12px; left: 12px;
    background: #1a1a2e;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    z-index: 10;
    letter-spacing: 0.5px;
  }
  #ba-slider-{{ section.id }} .ba-label--after {
    left: auto;
    right: 12px;
  }
  #ba-slider-{{ section.id }} .ba-divider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 3px;
    height: 100%;
    background: #fff;
    z-index: 20;
    transform: translateX(-50%);
    cursor: col-resize;
  }
  #ba-slider-{{ section.id }} .ba-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: #333;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    white-space: nowrap;
    gap: 2px;
  }
</style>

<script>
  (function() {
    var slider = document.getElementById('ba-slider-{{ section.id }}');
    if (!slider) return;
    var before = slider.querySelector('.ba-before');
    var divider = slider.querySelector('.ba-divider');
    var dragging = false;

    function setPosition(x) {
      var rect = slider.getBoundingClientRect();
      var pos = Math.min(Math.max((x - rect.left) / rect.width * 100, 0), 100);
      before.style.width = pos + '%';
      divider.style.left = pos + '%';
    }

    divider.addEventListener('mousedown', function(e) { dragging = true; e.preventDefault(); });
    window.addEventListener('mouseup', function() { dragging = false; });
    window.addEventListener('mousemove', function(e) { if (dragging) setPosition(e.clientX); });

    divider.addEventListener('touchstart', function(e) { dragging = true; }, { passive: true });
    window.addEventListener('touchend', function() { dragging = false; });
    window.addEventListener('touchmove', function(e) { if (dragging) setPosition(e.touches[0].clientX); }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Before and after",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From Desk Decor to Movie Scene" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Slide to see the difference. By day, it is a detailed handmade resin display. At night, the blue glow turns it into a dramatic monster scene for your room." },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "text", "id": "before_alt", "label": "Before alt text", "default": "Resin lamp in daylight" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "after_alt", "label": "After alt text", "default": "Resin lamp glowing at night" }
  ],
  "presets": [{ "name": "Before and after" }]
}
{% endschema %}