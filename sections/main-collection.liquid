<!-- Collection Hero -->
<div class="collection-hero">
  <div class="page-width collection-hero__inner">
    <p class="eyebrow-pill">
      <span class="live-dot" aria-hidden="true"></span>
      {{ section.settings.eyebrow }}
    </p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="collection-hero__sub">{{ section.settings.subheading }}</p>
  </div>
</div>

<!-- Collection Grid -->
<section class="collection-main page-width">

  <div class="collection-toolbar">
    <span class="collection-toolbar__count">
      {{ collection.products_count | default: 2 }}
      {%- if collection.products_count == 1 %} product{%- else %} products{%- endif %}
    </span>
    <form class="sort-form">
      <label for="SortBy" class="visually-hidden">Sort by</label>
      <select id="SortBy" name="sort_by" data-sort-by>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
        {%- if collection.sort_options.size == 0 -%}
          <option value="manual" selected>Featured</option>
          <option value="price-ascending">Price: Low to High</option>
          <option value="price-descending">Price: High to Low</option>
          <option value="created-descending">Newest</option>
        {%- endif -%}
      </select>
    </form>
  </div>

  <div class="product-grid">
    {%- if collection.products.size > 0 -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- elsif section.settings.fallback_product != blank -%}
      {% render 'product-card',
        product: section.settings.fallback_product,
        fallback_badge: section.settings.fallback_1_badge,
        fallback_reviews: section.settings.fallback_1_reviews
      %}
      {%- if section.settings.fallback_product_2 != blank -%}
        {% render 'product-card',
          product: section.settings.fallback_product_2,
          fallback_badge: section.settings.fallback_2_badge,
          fallback_reviews: section.settings.fallback_2_reviews
        %}
      {%- endif -%}
    {%- else -%}
      {% render 'product-card',
        fallback_title: section.settings.fallback_1_title,
        fallback_price: section.settings.fallback_1_price,
        fallback_compare: section.settings.fallback_1_compare,
        fallback_badge: section.settings.fallback_1_badge,
        fallback_reviews: section.settings.fallback_1_reviews,
        fallback_image: section.settings.fallback_1_image
      %}
      {% render 'product-card',
        fallback_title: section.settings.fallback_2_title,
        fallback_price: section.settings.fallback_2_price,
        fallback_compare: section.settings.fallback_2_compare,
        fallback_badge: section.settings.fallback_2_badge,
        fallback_reviews: section.settings.fallback_2_reviews,
        fallback_image: section.settings.fallback_2_image
      %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow pill text",
      "default": "New drops every week"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Shop All Lamps"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every lamp hand-poured by Lily — one at a time, never mass-produced."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Fallback product 1 (shown when no collection)"
    },
    {
      "type": "product",
      "id": "fallback_product",
      "label": "Product 1"
    },
    {
      "type": "text",
      "id": "fallback_1_title",
      "label": "Product 1 fallback title",
      "default": "Godzilla Resin Glow Lamp"
    },
    {
      "type": "text",
      "id": "fallback_1_price",
      "label": "Product 1 price",
      "default": "$89.95"
    },
    {
      "type": "text",
      "id": "fallback_1_compare",
      "label": "Product 1 compare-at",
      "default": "$129.95"
    },
    {
      "type": "text",
      "id": "fallback_1_badge",
      "label": "Product 1 badge",
      "default": "Best Seller"
    },
    {
      "type": "text",
      "id": "fallback_1_reviews",
      "label": "Product 1 review count",
      "default": "60+ reviews"
    },
    {
      "type": "image_picker",
      "id": "fallback_1_image",
      "label": "Product 1 image"
    },
    {
      "type": "header",
      "content": "Fallback product 2"
    },
    {
      "type": "product",
      "id": "fallback_product_2",
      "label": "Product 2"
    },
    {
      "type": "text",
      "id": "fallback_2_title",
      "label": "Product 2 fallback title",
      "default": "How to Train Your Dragon Resin Lamp"
    },
    {
      "type": "text",
      "id": "fallback_2_price",
      "label": "Product 2 price",
      "default": "$89.95"
    },
    {
      "type": "text",
      "id": "fallback_2_compare",
      "label": "Product 2 compare-at",
      "default": "$119.95"
    },
    {
      "type": "text",
      "id": "fallback_2_badge",
      "label": "Product 2 badge",
      "default": "New Arrival"
    },
    {
      "type": "text",
      "id": "fallback_2_reviews",
      "label": "Product 2 review count",
      "default": "45+ reviews"
    },
    {
      "type": "image_picker",
      "id": "fallback_2_image",
      "label": "Product 2 image"
    }
  ]
}
{% endschema %}
