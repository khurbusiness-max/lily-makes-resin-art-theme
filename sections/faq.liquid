<section class="faq page-width">
  <h2>{{ section.settings.heading }}</h2>
  <div class="faq__items">
    {%- for block in section.blocks -%}
      <div class="faq-item" {{ block.shopify_attributes }}>
        <button class="faq-item__button" type="button" aria-expanded="false" aria-controls="FaqPanel-{{ section.id }}-{{ forloop.index }}" data-accordion-trigger>
          <span class="faq-item__check" aria-hidden="true">✓</span>
          <span>{{ block.settings.question }}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="faq-item__panel" id="FaqPanel-{{ section.id }}-{{ forloop.index }}" hidden>
          {{ block.settings.answer }}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How are the lamps made?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Each lamp is individually hand-poured with resin, layered decorative details, and a built-in light source. Small variations are expected and make every piece unique.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How are the lamps made?"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do the lamps produce an animated effect like the videos?",
            "answer": "<p>The lamp creates a bright blue glow and layered scene depth. Video lighting and camera exposure can make the glow appear more dramatic, so real-life brightness may vary by room.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Does it come with a power cord and light?",
            "answer": "<p>Yes. The lamp includes the installed light component and a compatible power cord unless your product listing states otherwise.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Returns & guarantees",
            "answer": "<p>If your lamp arrives damaged, contact us with photos within 7 days of delivery. We will help with a replacement or return based on store policy.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
