<section class="testimonials page-width rv">
  <h2>{{ section.settings.heading }}</h2>

  {%- if section.settings.show_stats -%}
  <div class="stats-grid">
    <div class="stat-card rv">
      <b data-count="{{ section.settings.stat_1_value }}">0+</b>
      <small>{{ section.settings.stat_1_label }}</small>
    </div>
    <div class="stat-card rv">
      <b data-count="{{ section.settings.stat_2_value }}">0+</b>
      <small>{{ section.settings.stat_2_label }}</small>
    </div>
    <div class="stat-card rv">
      <b data-count="{{ section.settings.stat_3_value }}">0+</b>
      <small>{{ section.settings.stat_3_label }}</small>
    </div>
    <div class="stat-card rv">
      <b style="font-family:var(--font-display);font-size:2.4rem;color:var(--glow);display:block;line-height:1;margin-bottom:6px">{{ section.settings.stat_4_value }}</b>
      <small>{{ section.settings.stat_4_label }}</small>
    </div>
  </div>
  {%- endif -%}

  <div class="testimonial-grid">
    {%- for block in section.blocks -%}
      <article class="testimonial-card rv" {{ block.shopify_attributes }}>
        <div class="testimonial-card__image">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 720 }}" alt="{{ block.settings.image_alt | escape }}" width="720" height="540" loading="lazy">
          {%- else -%}
            <img src="{{ 'lmra-testimonial-' | append: forloop.index | append: '.svg' | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="720" height="540" loading="lazy">
          {%- endif -%}
          <span aria-hidden="true">"</span>
        </div>
        <div class="testimonial-card__body">
          <p class="verified-badge">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Verified Buyer
          </p>
          <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.quote }}</p>
          <strong>{{ block.settings.author }}</strong>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Godzilla Fans Are Saying"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show stats row",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 — number",
      "default": "60"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 — label",
      "default": "Verified Reviews"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 — number",
      "default": "127"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 — label",
      "default": "Happy Customers This Week"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 — number",
      "default": "100"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 — label",
      "default": "% Satisfaction Rate"
    },
    {
      "type": "text",
      "id": "stat_4_value",
      "label": "Stat 4 — text value",
      "default": "30-Day"
    },
    {
      "type": "text",
      "id": "stat_4_label",
      "label": "Stat 4 — label",
      "default": "Money-Back Guarantee"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Customer resin lamp photo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Perfect gift"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Got this as a gift and it instantly became the coziest piece on the desk. The blue glow and handmade resin details make it feel personal and premium."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Emily K."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "title": "Perfect gift",
            "author": "Emily K."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "title": "A real centerpiece",
            "quote": "I bought it for my son and he lit up the second he saw it. The blue glow looks incredible at night and feels much more special than a normal lamp.",
            "author": "Jason M."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "title": "Really surprised me",
            "quote": "It looks way cooler in person than expected. The glow gives the whole room a different feel, and everyone asks where it came from.",
            "author": "Marcus D."
          }
        }
      ]
    }
  ]
}
{% endschema %}
