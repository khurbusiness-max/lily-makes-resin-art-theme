{%- liquid
  assign featured_product = product
  if featured_product == blank
    assign featured_product = section.settings.featured_product
  endif

  assign selected_variant = blank
  if featured_product != blank
    assign selected_variant = featured_product.selected_or_first_available_variant
  endif

  assign product_title = section.settings.product_title
  assign price_text = section.settings.price_text
  assign compare_text = section.settings.compare_text

  if featured_product != blank
    assign product_title = featured_product.title
    assign price_text = selected_variant.price | money
    if selected_variant.compare_at_price > selected_variant.price
      assign compare_text = selected_variant.compare_at_price | money
    endif
  endif

  assign now_ts = 'now' | date: '%s' | plus: 0
  assign prep_ts = now_ts | plus: 604800
  assign deliver_ts = now_ts | plus: 1555200
-%}

<section class="product-hero" data-product-section data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="product-hero__grid">

      <!-- Gallery column -->
      <div class="product-hero__media">
        <div class="product-gallery">
          <div class="product-gallery__main">
            {%- assign first_image_rendered = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'gallery_image' and first_image_rendered == false -%}
                {%- assign first_image_rendered = true -%}
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.alt | escape }}" width="1200" height="1200" data-gallery-main>
                {%- else -%}
                  <svg class="product-placeholder" viewBox="0 0 1200 1200" role="img" aria-label="Product image placeholder">
                    <rect width="1200" height="1200" fill="#fce4ef"/>
                    <rect x="330" y="170" width="540" height="760" rx="30" fill="#f9a8d4"/>
                    <circle cx="600" cy="520" r="150" fill="#d63384"/>
                  </svg>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if first_image_rendered == false -%}
              <svg class="product-placeholder" viewBox="0 0 1200 1200" role="img" aria-label="Product image placeholder">
                <rect width="1200" height="1200" fill="#fce4ef"/>
                <rect x="330" y="170" width="540" height="760" rx="30" fill="#f9a8d4"/>
                <circle cx="600" cy="520" r="150" fill="#d63384"/>
              </svg>
            {%- endif -%}
          </div>

          <div class="product-gallery__thumbs" aria-label="Product images">
            {%- assign thumb_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'gallery_image' -%}
                {%- assign thumb_count = thumb_count | plus: 1 -%}
                {%- if block.settings.image != blank -%}
                  {%- assign thumb_url = block.settings.image | image_url: width: 300 -%}
                  {%- assign full_url = block.settings.image | image_url: width: 1200 -%}
                  <button class="product-gallery__thumb{% if thumb_count == 1 %} is-active{% endif %}" type="button" data-gallery-thumb data-full="{{ full_url }}" aria-label="Show product image {{ thumb_count }}" {{ block.shopify_attributes }}>
                    <img src="{{ thumb_url }}" alt="{{ block.settings.alt | escape }}" width="180" height="180">
                  </button>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <!-- Info column -->
      <div class="product-hero__info">
        <div class="eyebrow-pill">
          <span class="live-dot" aria-hidden="true"></span>
          {{ section.settings.orders_text }}
        </div>

        <h1>{{ product_title }}</h1>

        <div class="review-line" aria-label="{{ section.settings.review_text | escape }}">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span>{{ section.settings.review_text }}</span>
          {%- if section.settings.live_text != blank -%}
            <span class="pill-live">
              <span class="live-dot" style="width:6px;height:6px;" aria-hidden="true"></span>
              {{ section.settings.live_text }}
            </span>
          {%- endif -%}
        </div>

        <p class="stock-badge">
          <span class="stock-badge__dot" aria-hidden="true"></span>
          {{ section.settings.stock_badge }}
        </p>

        {%- if section.settings.product_lead != blank -%}
          <p class="product-lead">{{ section.settings.product_lead }}</p>
        {%- endif -%}

        <ul class="product-bullets">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bullet' -%}
              <li {{ block.shopify_attributes }}>
                <span class="product-bullets__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <div class="price-line">
          <span class="price" data-price-display>{{ price_text }}</span>
          <s data-compare-display>{{ compare_text }}</s>
          <span class="save-badge" data-save-display>{{ section.settings.save_badge }}</span>
        </div>

        {%- if section.settings.show_countdown -%}
          <div class="countdown" data-countdown aria-label="Sale countdown timer">
            <span>⚡ Sale ends in</span>
            <div class="countdown__clock">
              <div class="countdown__seg"><span data-cd-h>02</span><span class="countdown__seg-label">Hrs</span></div>
              <div class="countdown__seg"><span data-cd-m>59</span><span class="countdown__seg-label">Min</span></div>
              <div class="countdown__seg"><span data-cd-s>59</span><span class="countdown__seg-label">Sec</span></div>
            </div>
          </div>
        {%- endif -%}

        <form class="product-form" action="/cart/add" method="post" enctype="multipart/form-data" data-product-form>
          {%- if featured_product != blank -%}
            <script type="application/json" data-product-json>
              {{ featured_product | json }}
            </script>

            {%- unless section.settings.bundle_as_variant -%}
              <fieldset class="option-fieldset" data-option-group>
                <legend>{{ section.settings.variant_label }}</legend>
                {%- for variant in featured_product.variants -%}
                  <label
                    class="option-pill{% if variant.id == selected_variant.id %} is-active{% endif %}"
                    data-option-value="{{ variant.title | escape }}"
                    data-option-index="0"
                  >
                    <input type="radio" name="id" value="{{ variant.id }}" {% if variant.id == selected_variant.id %}checked{% endif %} {% unless variant.available %}disabled{% endunless %} style="display:none;">
                    {{ variant.title }}
                  </label>
                {%- endfor -%}
              </fieldset>
              <input type="hidden" data-variant-id value="{{ selected_variant.id }}">
            {%- else -%}
              <input type="hidden" name="id" data-variant-id value="{{ selected_variant.id }}">
            {%- endunless -%}
          {%- else -%}
            <input type="hidden" name="id" data-variant-id value="">
          {%- endif -%}

          <input type="hidden" name="quantity" value="1" data-product-quantity>

          <div class="bundle-heading" aria-hidden="true">
            <span></span>{{ section.settings.bundle_heading }}<span></span>
          </div>

          <fieldset class="bundle-options">
            <legend class="visually-hidden">{{ section.settings.bundle_heading }}</legend>

            {%- if section.settings.bundle_as_variant and featured_product != blank -%}
              {%- assign sorted_prices = featured_product.variants | map: 'price' | sort -%}
              {%- assign min_price = sorted_prices | first -%}
              {%- assign max_price = sorted_prices | last -%}
              {%- for variant in featured_product.variants -%}
                {%- if variant.price == min_price -%}
                  {%- assign size_word = 'Small' -%}
                  {%- assign fallback_compare = section.settings.bundle_1_compare -%}
                {%- elsif variant.price == max_price -%}
                  {%- assign size_word = 'Extra Large' -%}
                  {%- assign fallback_compare = section.settings.bundle_3_compare -%}
                {%- else -%}
                  {%- assign size_word = 'Large' -%}
                  {%- assign fallback_compare = section.settings.bundle_2_compare -%}
                {%- endif -%}
                <label class="bundle-card{% if variant.id == selected_variant.id %} is-active{% endif %}">
                  <input type="radio" name="bundle"
                         data-variant-select="{{ variant.id }}"
                         data-bundle-label="{{ size_word }} — {{ variant.title | escape }}"
                         {% if variant.id == selected_variant.id %}checked{% endif %}
                         {% unless variant.available %}disabled{% endunless %}>
                  <span>
                    <strong>{{ size_word }} — {{ variant.title }}</strong>
                    {%- if variant.price != min_price and variant.price != max_price -%}<em>Most Popular</em>{%- endif -%}
                  </span>
                  <span class="bundle-card__price">
                    <strong>{{ variant.price | money }}</strong>
                    {%- if variant.compare_at_price > variant.price -%}
                      <s>{{ variant.compare_at_price | money }}</s>
                    {%- elsif fallback_compare != blank -%}
                      <s>{{ fallback_compare }}</s>
                    {%- endif -%}
                  </span>
                </label>
              {%- endfor -%}
            {%- else -%}
              <label class="bundle-card is-active">
                <input type="radio" name="bundle" value="1" data-bundle-quantity="1" data-bundle-label="{{ section.settings.bundle_1_label }}" checked>
                <span><strong>{{ section.settings.bundle_1_label }}</strong></span>
                <span class="bundle-card__price">
                  <strong>{{ section.settings.bundle_1_price }}</strong>
                  <s>{{ section.settings.bundle_1_compare }}</s>
                </span>
              </label>

              <label class="bundle-card">
                <input type="radio" name="bundle" value="2" data-bundle-quantity="2" data-bundle-label="{{ section.settings.bundle_2_label }}">
                <span>
                  <strong>{{ section.settings.bundle_2_label }}</strong>
                  <em>{{ section.settings.bundle_2_badge }}</em>
                </span>
                <span class="bundle-card__price">
                  <strong>{{ section.settings.bundle_2_price }}</strong>
                  <s>{{ section.settings.bundle_2_compare }}</s>
                </span>
              </label>
            {%- endif -%}
          </fieldset>

          {%- if section.settings.urgency_text != blank -%}
            <p class="urgency-strip">
              <svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              {{ section.settings.urgency_text }}
            </p>
          {%- endif -%}

          <button class="button button--primary product-form__submit" type="submit" data-add-to-cart>
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            {{ section.settings.add_to_cart_text }}
          </button>

          {%- if featured_product == blank -%}
            <p class="form-message" role="status" data-form-message>Select the real Shopify product in Product hero settings first.</p>
          {%- else -%}
            <p class="form-message" role="status" data-form-message></p>
          {%- endif -%}

          {%- if section.settings.guarantee_text != blank -%}
            <p class="guarantee-note">
              <svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              {{ section.settings.guarantee_text }}
            </p>
          {%- endif -%}
        </form>

        <div class="payment-icons" aria-label="Accepted payment methods">
          {%- if shop.enabled_payment_types.size > 0 -%}
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}
            {%- endfor -%}
          {%- else -%}
            <span>Amex</span><span>Apple Pay</span><span>Discover</span><span>Google Pay</span><span>Mastercard</span><span>PayPal</span><span>Visa</span>
          {%- endif -%}
        </div>

        <div class="shipping-timeline" aria-label="Shipping timeline">
          <div class="shipping-timeline__line"></div>
          <div class="shipping-step">
            <span class="shipping-step__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h15l-2 9H8L6 3H3"/></svg></span>
            <strong>{{ now_ts | date: "%b %-d" }}</strong>
            <span>{{ section.settings.timeline_ordered }}</span>
          </div>
          <div class="shipping-step">
            <span class="shipping-step__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/></svg></span>
            <strong>{{ prep_ts | date: "%b %-d" }} – {{ prep_ts | plus: 691200 | date: "%b %-d" }}</strong>
            <span>{{ section.settings.timeline_prepared }}</span>
          </div>
          <div class="shipping-step">
            <span class="shipping-step__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12v10H4V12m16 0H4m16 0-2-6H6l-2 6m8-6v16"/></svg></span>
            <strong>{{ deliver_ts | date: "%b %-d" }} – {{ deliver_ts | plus: 864000 | date: "%b %-d" }}</strong>
            <span>{{ section.settings.timeline_delivered }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Full-width Trust Strip -->
  <div class="trust-strip">
    <div class="page-width">
      <div class="trust-strip-in">
        <div class="trust-cell">
          <span class="trust-cell__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 18H3V6h13v8M16 8h4l3 4v4h-2M7 18a2 2 0 1 0 4 0 2 2 0 0 0-4 0m9 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/></svg></span>
          <div><b>Free Worldwide Shipping</b><small>No minimum order</small></div>
        </div>
        <div class="trust-cell">
          <span class="trust-cell__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div><b>30-Day Guarantee</b><small>Love it or we refund it</small></div>
        </div>
        <div class="trust-cell">
          <span class="trust-cell__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 15 8l6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg></span>
          <div><b>Handcrafted</b><small>One at a time by Lily</small></div>
        </div>
        <div class="trust-cell">
          <span class="trust-cell__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
          <div><b>Secure Checkout</b><small>Encrypted payment</small></div>
        </div>
      </div>
    </div>
  </div>

  {%- if section.settings.show_sticky_bar -%}
    <div class="sticky-atc" data-sticky-atc>
      <div>
        <strong>{{ product_title }}</strong>
        <p><span data-price-display>{{ price_text }}</span> <s data-compare-display>{{ compare_text }}</s> <em data-save-display>{{ section.settings.save_badge }}</em></p>
      </div>
      <button class="button button--primary" type="button" data-sticky-add>
        {{ section.settings.add_to_cart_text }}
      </button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product hero",
  "settings": [
    { "type": "product", "id": "featured_product", "label": "Featured product" },
    { "type": "text", "id": "product_title", "label": "Fallback product title", "default": "Lily's Art | Godzilla Resin Glow Lamp" },
    { "type": "text", "id": "stock_badge", "label": "Stock badge", "default": "Low Stock — Only 7 Left" },
    { "type": "text", "id": "orders_text", "label": "Eyebrow / recent orders text", "default": "127+ happy customers this week" },
    { "type": "text", "id": "live_text", "label": "Live viewers pill (leave blank to hide)", "default": "12 viewing now" },
    { "type": "text", "id": "review_text", "label": "Review text", "default": "4.9/5.0 (60+ Verified Reviews)" },
    { "type": "textarea", "id": "product_lead", "label": "Product description (lead)", "default": "A hand-poured resin scene frozen in glass — stunning desk decor by day, and an electric blue monster glow show by night." },
    { "type": "text", "id": "price_text", "label": "Fallback price", "default": "$89.95" },
    { "type": "text", "id": "compare_text", "label": "Fallback compare-at price", "default": "$129.95" },
    { "type": "text", "id": "save_badge", "label": "Discount badge", "default": "SAVE 30%" },
    { "type": "text", "id": "variant_label", "label": "Variant label", "default": "Size" },
    { "type": "checkbox", "id": "bundle_as_variant", "label": "Use size cards as the variant selector (hides the small pill row)", "default": false },
    { "type": "text", "id": "bundle_heading", "label": "Bundle heading", "default": "BUNDLE & SAVE" },
    { "type": "text", "id": "bundle_1_label", "label": "Bundle 1 label", "default": "Buy 1 — Keep for yourself" },
    { "type": "text", "id": "bundle_1_price", "label": "Bundle 1 price", "default": "$89.95" },
    { "type": "text", "id": "bundle_1_compare", "label": "Bundle 1 compare-at price", "default": "$129.95" },
    { "type": "text", "id": "bundle_2_label", "label": "Bundle 2 label", "default": "Buy 2 — Perfect Gift Set" },
    { "type": "text", "id": "bundle_2_badge", "label": "Bundle 2 badge", "default": "Best Value" },
    { "type": "text", "id": "bundle_2_price", "label": "Bundle 2 price", "default": "$161.91" },
    { "type": "text", "id": "bundle_2_compare", "label": "Bundle 2 compare-at price", "default": "$259.90" },
    { "type": "text", "id": "bundle_3_compare", "label": "Bundle 3 (Extra Large) compare-at price", "default": "" },
    { "type": "text", "id": "urgency_text", "label": "Urgency message", "default": "Hurry — only 7 left in stock at this price" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee note", "default": "30-Day Satisfaction Guarantee — hassle-free returns" },
    { "type": "text", "id": "add_to_cart_text", "label": "Add to cart button", "default": "ADD TO CART — FREE SHIPPING" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown timer", "default": true },
    { "type": "text", "id": "timeline_ordered", "label": "Timeline ordered label", "default": "Ordered" },
    { "type": "text", "id": "timeline_prepared", "label": "Timeline prepared label", "default": "Handmade & Prepared" },
    { "type": "text", "id": "timeline_delivered", "label": "Timeline delivered label", "default": "Delivered" },
    { "type": "checkbox", "id": "show_sticky_bar", "label": "Show sticky add-to-cart bar", "default": true }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Godzilla resin glow lamp" }
      ]
    },
    {
      "type": "bullet",
      "name": "Product bullet",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "✓" },
        { "type": "text", "id": "text", "label": "Text", "default": "Hand-poured resin Godzilla sculpture — each one unique" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product hero",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "bullet", "settings": { "icon": "✓", "text": "Hand-poured resin Godzilla sculpture — every pour is one of a kind" } },
        { "type": "bullet", "settings": { "icon": "✓", "text": "Electric blue LED glow transforms any room after dark" } },
        { "type": "bullet", "settings": { "icon": "✓", "text": "Solid resin on real wood — display it anywhere, forever" } },
        { "type": "bullet", "settings": { "icon": "✓", "text": "The collector's gift Kaiju fans can't stop showing off" } }
      ]
    }
  ]
}
{% endschema %}
