{%- liquid
  assign featured_product = product
  if featured_product == blank
    assign featured_product = section.settings.featured_product
  endif

  assign selected_variant = blank
  if featured_product != blank
    assign selected_variant = featured_product.selected_or_first_available_variant
  endif

  assign product_title = section.settings.product_title
  assign price_text = section.settings.price_text
  assign compare_text = section.settings.compare_text

  if featured_product != blank
    assign product_title = featured_product.title
    assign price_text = selected_variant.price | money
    if selected_variant.compare_at_price > selected_variant.price
      assign compare_text = selected_variant.compare_at_price | money
    endif
  endif

  assign now_ts = 'now' | date: '%s' | plus: 0
  assign prep_ts = now_ts | plus: 604800
  assign deliver_ts = now_ts | plus: 1555200
-%}

<section class="product-hero page-width" data-product-section data-section-id="{{ section.id }}">
  <div class="product-hero__media">
    <div class="product-gallery">
      <div class="product-gallery__main">
        {%- assign first_image_rendered = false -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_image' and first_image_rendered == false -%}
            {%- assign first_image_rendered = true -%}

            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.alt | escape }}" width="1200" height="1200" data-gallery-main>
            {%- else -%}
              <svg class="product-placeholder" viewBox="0 0 1200 1200" role="img" aria-label="Product image placeholder">
                <rect width="1200" height="1200" fill="#050609"/>
                <rect x="330" y="170" width="540" height="760" rx="30" fill="#273985"/>
                <circle cx="600" cy="520" r="150" fill="#38bdf8"/>
              </svg>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if first_image_rendered == false -%}
          <svg class="product-placeholder" viewBox="0 0 1200 1200" role="img" aria-label="Product image placeholder">
            <rect width="1200" height="1200" fill="#050609"/>
            <rect x="330" y="170" width="540" height="760" rx="30" fill="#273985"/>
            <circle cx="600" cy="520" r="150" fill="#38bdf8"/>
          </svg>
        {%- endif -%}
      </div>

      <div class="product-gallery__thumbs" aria-label="Product images">
        {%- assign thumb_count = 0 -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_image' -%}
            {%- assign thumb_count = thumb_count | plus: 1 -%}

            {%- if block.settings.image != blank -%}
              {%- assign thumb_url = block.settings.image | image_url: width: 300 -%}
              {%- assign full_url = block.settings.image | image_url: width: 1200 -%}

              <button class="product-gallery__thumb{% if thumb_count == 1 %} is-active{% endif %}" type="button" data-gallery-thumb data-full="{{ full_url }}" aria-label="Show product image {{ thumb_count }}" {{ block.shopify_attributes }}>
                <img src="{{ thumb_url }}" alt="{{ block.settings.alt | escape }}" width="180" height="180">
              </button>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="trust-row" aria-label="Customer guarantees">
      <div class="trust-item">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>{{ section.settings.trust_1 }}</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>{{ section.settings.trust_2 }}</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <span>{{ section.settings.trust_3 }}</span>
      </div>
    </div>
  </div>

  <div class="product-hero__info">
    <p class="stock-badge">
      <span class="stock-badge__dot" aria-hidden="true"></span>
      {{ section.settings.stock_badge }}
    </p>
    <h1>{{ product_title }}</h1>

    <div class="social-proof" aria-label="{{ section.settings.orders_text | escape }}">
      <div class="social-proof__avatars" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <strong>{{ section.settings.orders_text }}</strong>
    </div>

    <div class="review-line" aria-label="{{ section.settings.review_text | escape }}">
      <span class="stars" aria-hidden="true">★★★★★</span>
      <span>{{ section.settings.review_text }}</span>
    </div>

    <div class="price-line">
      <span class="price">{{ price_text }}</span>
      <s>{{ compare_text }}</s>
      <span class="save-badge">{{ section.settings.save_badge }}</span>
    </div>

    <ul class="product-bullets">
      {%- for block in section.blocks -%}
        {%- if block.type == 'bullet' -%}
          <li {{ block.shopify_attributes }}>
            <span class="product-bullets__icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {{ block.settings.text }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <form class="product-form" action="/cart/add" method="post" enctype="multipart/form-data" data-product-form>
      {%- if featured_product != blank -%}
        <script type="application/json" data-product-json>
          {{ featured_product | json }}
        </script>

        <fieldset class="option-fieldset" data-option-group>
          <legend>{{ section.settings.variant_label }}</legend>

          {%- for variant in featured_product.variants -%}
            <label
              class="option-pill{% if variant.id == selected_variant.id %} is-active{% endif %}"
              data-option-value="{{ variant.title | escape }}"
              data-option-index="0"
            >
              <input
                type="radio"
                name="id"
                value="{{ variant.id }}"
                {% if variant.id == selected_variant.id %}checked{% endif %}
                {% unless variant.available %}disabled{% endunless %}
                style="display:none;"
              >
              {{ variant.title }}
            </label>
          {%- endfor -%}
        </fieldset>

        <input type="hidden" data-variant-id value="{{ selected_variant.id }}">
      {%- else -%}
        <input type="hidden" name="id" data-variant-id value="">
      {%- endif -%}

      <input type="hidden" name="quantity" value="1" data-product-quantity>

      <div class="bundle-heading" aria-hidden="true">
        <span></span>{{ section.settings.bundle_heading }}<span></span>
      </div>

      <fieldset class="bundle-options">
        <legend class="visually-hidden">{{ section.settings.bundle_heading }}</legend>

        <label class="bundle-card is-active">
          <input type="radio" name="bundle" value="1" data-bundle-quantity="1" data-bundle-label="{{ section.settings.bundle_1_label }}" checked>
          <span><strong>{{ section.settings.bundle_1_label }}</strong></span>
          <span class="bundle-card__price">
            <strong>{{ section.settings.bundle_1_price }}</strong>
            <s>{{ section.settings.bundle_1_compare }}</s>
          </span>
        </label>

        <label class="bundle-card">
          <input type="radio" name="bundle" value="2" data-bundle-quantity="2" data-bundle-label="{{ section.settings.bundle_2_label }}">
          <span>
            <strong>{{ section.settings.bundle_2_label }}</strong>
            <em>{{ section.settings.bundle_2_badge }}</em>
          </span>
          <span class="bundle-card__price">
            <strong>{{ section.settings.bundle_2_price }}</strong>
            <s>{{ section.settings.bundle_2_compare }}</s>
          </span>
        </label>
      </fieldset>

      {%- if section.settings.urgency_text != blank -%}
        <p class="urgency-strip">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          {{ section.settings.urgency_text }}
        </p>
      {%- endif -%}

      <button class="button button--primary product-form__submit" type="submit" data-add-to-cart>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        {{ section.settings.add_to_cart_text }}
      </button>

      {%- if featured_product == blank -%}
        <p class="form-message" role="status" data-form-message>Select the real Shopify product in Product hero settings first.</p>
      {%- else -%}
        <p class="form-message" role="status" data-form-message></p>
      {%- endif -%}

      {%- if section.settings.guarantee_text != blank -%}
        <p class="guarantee-note">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          {{ section.settings.guarantee_text }}
        </p>
      {%- endif -%}
    </form>

    <div class="payment-icons" aria-label="Accepted payment methods">
      {%- if shop.enabled_payment_types.size > 0 -%}
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}
        {%- endfor -%}
      {%- else -%}
        <span>Amex</span><span>Apple Pay</span><span>Discover</span><span>Google Pay</span><span>Mastercard</span><span>PayPal</span><span>Visa</span>
      {%- endif -%}
    </div>

    <div class="shipping-timeline" aria-label="Shipping timeline">
      <div class="shipping-timeline__line"></div>

      <div class="shipping-step">
        <span class="shipping-step__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h15l-2 9H8L6 3H3"/></svg>
        </span>
        <strong>{{ now_ts | date: "%b %-d" }}</strong>
        <span>{{ section.settings.timeline_ordered }}</span>
      </div>

      <div class="shipping-step">
        <span class="shipping-step__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/></svg>
        </span>
        <strong>{{ prep_ts | date: "%b %-d" }} – {{ prep_ts | plus: 691200 | date: "%b %-d" }}</strong>
        <span>{{ section.settings.timeline_prepared }}</span>
      </div>

      <div class="shipping-step">
        <span class="shipping-step__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12v10H4V12m16 0H4m16 0-2-6H6l-2 6m8-6v16"/></svg>
        </span>
        <strong>{{ deliver_ts | date: "%b %-d" }} – {{ deliver_ts | plus: 864000 | date: "%b %-d" }}</strong>
        <span>{{ section.settings.timeline_delivered }}</span>
      </div>
    </div>
  </div>

  {%- if section.settings.show_sticky_bar -%}
    <div class="sticky-atc" data-sticky-atc>
      <div>
        <strong>{{ product_title }}</strong>
        <p><span>{{ price_text }}</span> <s>{{ compare_text }}</s> <em>{{ section.settings.save_badge }}</em></p>
      </div>

      <button class="button button--primary" type="button" data-sticky-add>
        {{ section.settings.add_to_cart_text }}
      </button>
    </div>
  {%- endif -%}
</section>

