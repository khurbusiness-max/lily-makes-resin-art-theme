{%- liquid
  assign featured_product = product
  if featured_product == blank
    assign featured_product = section.settings.featured_product
  endif

  assign selected_variant = blank
  if featured_product != blank
    assign selected_variant = featured_product.selected_or_first_available_variant
  endif

  assign product_title = section.settings.product_title
  assign price_text = section.settings.price_text
  assign compare_text = section.settings.compare_text

  if featured_product != blank
    assign product_title = featured_product.title
    assign price_text = selected_variant.price | money
    if selected_variant.compare_at_price > selected_variant.price
      assign compare_text = selected_variant.compare_at_price | money
    endif
  endif

  assign now_ts = 'now' | date: '%s' | plus: 0
  assign prep_ts = now_ts | plus: 604800
  assign deliver_ts = now_ts | plus: 1555200
-%}

<section class="product-hero page-width" data-product-section data-section-id="{{ section.id }}">
  <div class="product-hero__media">
    <div class="product-gallery">
      <div class="product-gallery__main">
        {%- assign first_image_rendered = false -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_image' and first_image_rendered == false -%}
            {%- assign first_image_rendered = true -%}

            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.alt | escape }}" width="1200" height="1200" data-gallery-main>
            {%- else -%}
              <svg class="product-placeholder" viewBox="0 0 1200 1200" role="img" aria-label="Product image placeholder">
                <rect width="1200" height="1200" fill="#050609"></rect>
                <rect x="330" y="170" width="540" height="760" rx="30" fill="#273985"></rect>
                <circle cx="600" cy="520" r="150" fill="#38bdf8"></circle>
              </svg>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if first_image_rendered == false -%}
          <svg class="product-placeholder" viewBox="0 0 1200 1200" role="img" aria-label="Product image placeholder">
            <rect width="1200" height="1200" fill="#050609"></rect>
            <rect x="330" y="170" width="540" height="760" rx="30" fill="#273985"></rect>
            <circle cx="600" cy="520" r="150" fill="#38bdf8"></circle>
          </svg>
        {%- endif -%}
      </div>

      <div class="product-gallery__thumbs" aria-label="Product images">
        {%- assign thumb_count = 0 -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_image' -%}
            {%- assign thumb_count = thumb_count | plus: 1 -%}

            {%- if block.settings.image != blank -%}
              {%- assign thumb_url = block.settings.image | image_url: width: 300 -%}
              {%- assign full_url = block.settings.image | image_url: width: 1200 -%}

              <button class="product-gallery__thumb{% if thumb_count == 1 %} is-active{% endif %}" type="button" data-gallery-thumb data-full="{{ full_url }}" aria-label="Show product image {{ thumb_count }}" {{ block.shopify_attributes }}>
                <img src="{{ thumb_url }}" alt="{{ block.settings.alt | escape }}" width="180" height="180">
              </button>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="product-hero__info">
    <p class="stock-badge">{{ section.settings.stock_badge }}</p>
    <h1>{{ product_title }}</h1>

    <div class="social-proof" aria-label="{{ section.settings.orders_text | escape }}">
      <div class="social-proof__avatars" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <strong>{{ section.settings.orders_text }}</strong>
    </div>

    <div class="review-line" aria-label="{{ section.settings.review_text | escape }}">
      <span class="stars" aria-hidden="true">★★★★★</span>
      <span>{{ section.settings.review_text }}</span>
    </div>

    <div class="price-line">
      <span class="price">{{ price_text }}</span>
      <s>{{ compare_text }}</s>
      <span class="save-badge">{{ section.settings.save_badge }}</span>
    </div>

    <ul class="product-bullets">
      {%- for block in section.blocks -%}
        {%- if block.type == 'bullet' -%}
          <li {{ block.shopify_attributes }}>
            <span aria-hidden="true">{{ block.settings.icon }}</span>{{ block.settings.text }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <form class="product-form" action="/cart/add" method="post" enctype="multipart/form-data" data-product-form>
      <input type="hidden" name="id" data-variant-id value="{% if selected_variant != blank %}{{ selected_variant.id }}{% endif %}">
      <input type="hidden" name="quantity" data-product-quantity value="1">

      {%- if featured_product != blank -%}
        <script type="application/json" data-product-json>{{ featured_product | json }}</script>
      {%- endif -%}

      <fieldset class="option-fieldset" data-option-group>
        <legend>{{ section.settings.variant_label }}</legend>

        <button class="option-pill is-active" type="button" data-option-index="0" data-option-value="{{ section.settings.size_small | escape }}" aria-pressed="true">
          {{ section.settings.size_small }}
        </button>

        <button class="option-pill" type="button" data-option-index="0" data-option-value="{{ section.settings.size_large | escape }}" aria-pressed="false">
          {{ section.settings.size_large }}
        </button>
      </fieldset>

      <div class="bundle-heading" aria-hidden="true">
        <span></span>{{ section.settings.bundle_heading }}<span></span>
      </div>

      <fieldset class="bundle-options" data-bundle-group>
        <legend class="visually-hidden">{{ section.settings.bundle_heading }}</legend>

        <label class="bundle-card is-active">
          <input type="radio" name="bundle" value="1" checked data-bundle-quantity="1">
          <span><strong>{{ section.settings.bundle_1_label }}</strong></span>
          <span class="bundle-card__price">
            <strong>{{ section.settings.bundle_1_price }}</strong>
            <s>{{ section.settings.bundle_1_compare }}</s>
          </span>
        </label>

        <label class="bundle-card">
          <input type="radio" name="bundle" value="2" data-bundle-quantity="2">
          <span>
            <strong>{{ section.settings.bundle_2_label }}</strong>
            <em>{{ section.settings.bundle_2_badge }}</em>
          </span>
          <span class="bundle-card__price">
            <strong>{{ section.settings.bundle_2_price }}</strong>
            <s>{{ section.settings.bundle_2_compare }}</s>
          </span>
        </label>
      </fieldset>

      <button class="button button--primary product-form__submit" type="submit" data-add-to-cart>
        {{ section.settings.add_to_cart_text }}
      </button>

      <p class="form-message" role="status" data-form-message></p>
    </form>

    <div class="payment-icons" aria-label="Accepted payment methods">
      {%- if shop.enabled_payment_types.size > 0 -%}
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}
        {%- endfor -%}
      {%- else -%}
        <span>Amex</span><span>Apple Pay</span><span>Discover</span><span>Google Pay</span><span>Mastercard</span><span>PayPal</span><span>Visa</span>
      {%- endif -%}
    </div>

    <div class="shipping-timeline" aria-label="Shipping timeline">
      <div class="shipping-timeline__line"></div>

      <div class="shipping-step">
        <span class="shipping-step__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h15l-2 9H8L6 3H3"/></svg>
        </span>
        <strong>{{ now_ts | date: "%b %-d" }}</strong>
        <span>{{ section.settings.timeline_ordered }}</span>
      </div>

      <div class="shipping-step">
        <span class="shipping-step__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/></svg>
        </span>
        <strong>{{ prep_ts | date: "%b %-d" }} - {{ prep_ts | plus: 691200 | date: "%b %-d" }}</strong>
        <span>{{ section.settings.timeline_prepared }}</span>
      </div>

      <div class="shipping-step">
        <span class="shipping-step__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12v10H4V12m16 0H4m16 0-2-6H6l-2 6m8-6v16"/></svg>
        </span>
        <strong>{{ deliver_ts | date: "%b %-d" }} - {{ deliver_ts | plus: 864000 | date: "%b %-d" }}</strong>
        <span>{{ section.settings.timeline_delivered }}</span>
      </div>
    </div>
  </div>

  {%- if section.settings.show_sticky_bar -%}
    <div class="sticky-atc" data-sticky-atc>
      <div>
        <strong>{{ product_title }}</strong>
        <p><span>{{ price_text }}</span> <s>{{ compare_text }}</s> <em>{{ section.settings.save_badge }}</em></p>
      </div>

      <button class="button button--primary" type="button" data-sticky-add>
        {{ section.settings.add_to_cart_text }}
      </button>
    </div>
  {%- endif -%}
</section>

<script>
  document.addEventListener('click', function(event) {
    var optionButton = event.target.closest('[data-option-value]');
    if (!optionButton) return;

    var form = optionButton.closest('[data-product-form]');
    if (!form) return;

    var group = optionButton.closest('[data-option-group]');
    if (group) {
      group.querySelectorAll('[data-option-value]').forEach(function(button) {
        button.classList.remove('is-active');
        button.setAttribute('aria-pressed', 'false');
      });
    }

    optionButton.classList.add('is-active');
    optionButton.setAttribute('aria-pressed', 'true');

    var productJson = form.querySelector('[data-product-json]');
    var variantInput = form.querySelector('[data-variant-id]');
    if (!productJson || !variantInput) return;

    var product = JSON.parse(productJson.textContent);
    var selectedValue = optionButton.getAttribute('data-option-value');

    var variant = product.variants.find(function(item) {
      return item.options.indexOf(selectedValue) !== -1;
    });

    if (variant) {
      variantInput.value = variant.id;
    }
  });

  document.addEventListener('change', function(event) {
    if (!event.target.matches('[data-bundle-quantity]')) return;

    var form = event.target.closest('[data-product-form]');
    if (!form) return;

    var quantityInput = form.querySelector('[data-product-quantity]');
    if (quantityInput) {
      quantityInput.value = event.target.getAttribute('data-bundle-quantity') || '1';
    }

    form.querySelectorAll('.bundle-card').forEach(function(card) {
      card.classList.remove('is-active');
    });

    var selectedCard = event.target.closest('.bundle-card');
    if (selectedCard) selectedCard.classList.add('is-active');
  });

  document.addEventListener('submit', function(event) {
    var form = event.target;
    if (!form.matches('[data-product-form]')) return;

    event.preventDefault();

    var message = form.querySelector('[data-form-message]');
    var button = form.querySelector('[data-add-to-cart]');
    var variantInput = form.querySelector('[data-variant-id]');
    var quantityInput = form.querySelector('[data-product-quantity]');

    if (!variantInput || !variantInput.value) {
      if (message) message.textContent = 'Please select a product in Product hero settings first.';
      return;
    }

    if (button) button.disabled = true;
    if (message) message.textContent = 'Adding...';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
        'Accept': 'application/json'
      },
      body:
        'id=' + encodeURIComponent(variantInput.value) +
        '&quantity=' + encodeURIComponent(quantityInput ? quantityInput.value : '1')
    })
      .then(function(response) {
        if (!response.ok) {
          return response.json().then(function(errorData) {
            throw new Error(errorData.description || errorData.message || 'Could not add to cart.');
          });
        }
        return response.json();
      })
      .then(function() {
        return fetch('/cart.js');
      })
      .then(function(cartResponse) {
        return cartResponse.json();
      })
      .then(function(cart) {
        document.querySelectorAll('[data-cart-count]').forEach(function(count) {
          count.textContent = cart.item_count;
        });

        if (message) message.textContent = 'Added to cart.';

        var cartButton = document.querySelector('[data-cart-open]');
        if (cartButton) cartButton.click();
      })
      .catch(function(error) {
        if (message) message.textContent = error.message || 'Could not add to cart.';
      })
      .finally(function() {
        if (button) button.disabled = false;
      });
  });

  document.addEventListener('click', function(event) {
    var stickyButton = event.target.closest('[data-sticky-add]');
    if (!stickyButton) return;

    var form = document.querySelector('[data-product-form]');
    if (!form) return;

    if (typeof form.requestSubmit === 'function') {
      form.requestSubmit();
    } else {
      form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
    }
  });
</script>

