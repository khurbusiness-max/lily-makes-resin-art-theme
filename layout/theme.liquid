<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#273985' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}
    <style>
      :root {
        --color-primary: {{ settings.color_primary | default: '#273985' }};
        --color-accent: {{ settings.color_accent | default: '#38bdf8' }};
        --color-background: {{ settings.color_background | default: '#ffffff' }};
        --color-text: {{ settings.color_text | default: '#101114' }};
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      window.LMRA = {
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          checkout: '/checkout'
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% render 'cart-drawer' %}
    {% section 'footer' %}
  </body>
</html>
